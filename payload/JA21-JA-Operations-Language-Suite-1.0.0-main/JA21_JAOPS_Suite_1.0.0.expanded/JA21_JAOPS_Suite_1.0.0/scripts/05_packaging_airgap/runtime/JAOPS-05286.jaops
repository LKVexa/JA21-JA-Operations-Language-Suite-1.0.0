ja source 0.3
module corpus.ja_operations.example_05286
use Operations
policy explicit_network

workspace SuiteJAOPS_05286 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_50 replicas 3
    health_check worker_50 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05286.msslb"