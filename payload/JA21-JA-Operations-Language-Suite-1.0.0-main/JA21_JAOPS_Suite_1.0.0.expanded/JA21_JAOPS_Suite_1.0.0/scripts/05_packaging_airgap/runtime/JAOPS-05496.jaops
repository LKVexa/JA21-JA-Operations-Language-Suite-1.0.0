module corpus.ja_operations.example_05496
use Operations
policy explicit_network

workspace SuiteJAOPS_05496 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_66 replicas 1
    health_check worker_66 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05496.msslb"