module corpus.ja_operations.example_05766
use Operations
policy explicit_network

workspace SuiteJAOPS_05766 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_45 replicas 3
    health_check worker_45 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05766.msslb"