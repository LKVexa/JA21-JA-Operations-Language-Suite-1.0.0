ja source 0.3
module corpus.ja_operations.example_05456
use Operations
policy explicit_network

workspace SuiteJAOPS_05456 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_26 replicas 1
    health_check worker_26 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05456.msslb"