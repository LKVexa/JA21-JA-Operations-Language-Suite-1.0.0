ja source 0.3
module corpus.ja_operations.example_09180
use Operations
policy explicit_network

workspace SuiteJAOPS_09180 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_64 replicas 1
    health_check worker_64 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09180.msslb"