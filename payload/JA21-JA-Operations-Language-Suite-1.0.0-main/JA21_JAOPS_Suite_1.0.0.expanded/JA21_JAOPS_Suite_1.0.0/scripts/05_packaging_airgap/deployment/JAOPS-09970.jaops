module corpus.ja_operations.example_09970
use Operations
policy explicit_network

workspace SuiteJAOPS_09970 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 6GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_78 replicas 3
    health_check worker_78 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_09970.msslb"