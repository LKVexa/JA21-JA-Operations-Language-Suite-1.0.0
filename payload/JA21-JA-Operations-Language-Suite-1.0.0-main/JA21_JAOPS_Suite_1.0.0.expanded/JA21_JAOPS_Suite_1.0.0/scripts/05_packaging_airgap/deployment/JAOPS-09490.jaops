module corpus.ja_operations.example_09490
use Operations
policy explicit_network

workspace SuiteJAOPS_09490 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 6GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_83 replicas 3
    health_check worker_83 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_09490.msslb"