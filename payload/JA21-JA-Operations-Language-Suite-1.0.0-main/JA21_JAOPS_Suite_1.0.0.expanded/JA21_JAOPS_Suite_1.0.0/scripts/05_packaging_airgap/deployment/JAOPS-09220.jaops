ja source 0.3
module corpus.ja_operations.example_09220
use Operations
policy explicit_network

workspace SuiteJAOPS_09220 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_7 replicas 1
    health_check worker_7 every 19s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09220.msslb"