ja source 0.3
module corpus.ja_operations.example_09660
use Operations
policy explicit_network

workspace SuiteJAOPS_09660 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_59 replicas 1
    health_check worker_59 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09660.msslb"