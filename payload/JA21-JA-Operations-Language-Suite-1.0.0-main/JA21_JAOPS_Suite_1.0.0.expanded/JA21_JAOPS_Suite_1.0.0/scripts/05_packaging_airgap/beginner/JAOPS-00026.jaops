ja source 0.3
module corpus.ja_operations.example_00026
use Operations
policy explicit_network

workspace SuiteJAOPS_00026 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_28 replicas 3
    health_check worker_28 every 32s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00026.msslb"