ja source 0.3
module corpus.ja_operations.example_00351
use Operations
policy explicit_network

workspace SuiteJAOPS_00351 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_62 replicas 4
    health_check worker_62 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00351.msslb"