ja source 0.3
module corpus.ja_operations.example_00841
use Operations
policy explicit_network

workspace SuiteJAOPS_00841 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_67 replicas 2
    health_check worker_67 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00841.msslb"