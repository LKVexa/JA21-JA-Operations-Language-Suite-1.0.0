ja source 0.3
module corpus.ja_operations.example_00521
use Operations
policy explicit_network

workspace SuiteJAOPS_00521 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_38 replicas 2
    health_check worker_38 every 31s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00521.msslb"