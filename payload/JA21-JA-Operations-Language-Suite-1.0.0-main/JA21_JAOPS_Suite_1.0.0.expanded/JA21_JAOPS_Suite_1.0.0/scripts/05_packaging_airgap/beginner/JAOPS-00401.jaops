ja source 0.3
module corpus.ja_operations.example_00401
use Operations
policy explicit_network

workspace SuiteJAOPS_00401 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_15 replicas 2
    health_check worker_15 every 35s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00401.msslb"