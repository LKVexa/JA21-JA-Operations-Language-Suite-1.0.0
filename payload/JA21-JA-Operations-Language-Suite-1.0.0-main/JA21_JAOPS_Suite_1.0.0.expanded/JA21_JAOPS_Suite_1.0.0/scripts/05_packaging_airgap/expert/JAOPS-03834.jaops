module corpus.ja_operations.example_03834
use Operations
policy explicit_network

workspace SuiteJAOPS_03834 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_53 replicas 3
    health_check worker_53 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03834.msslb"