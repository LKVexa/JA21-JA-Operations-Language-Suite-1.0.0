module corpus.ja_operations.example_03664
use Operations
policy explicit_network

workspace SuiteJAOPS_03664 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_77 replicas 1
    health_check worker_77 every 12s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03664.msslb"