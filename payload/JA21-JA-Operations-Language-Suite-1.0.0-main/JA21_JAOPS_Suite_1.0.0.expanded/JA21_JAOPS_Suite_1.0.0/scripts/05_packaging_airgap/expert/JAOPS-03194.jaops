ja source 0.3
module corpus.ja_operations.example_03194
use Operations
policy explicit_network

workspace SuiteJAOPS_03194 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_92 replicas 3
    health_check worker_92 every 7s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03194.msslb"