ja source 0.3
module corpus.ja_operations.example_02823
use Operations
policy explicit_network

workspace SuiteJAOPS_02823 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_12 replicas 4
    health_check worker_12 every 8s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02823.msslb"