ja source 0.3
module corpus.ja_operations.example_02613
use Operations
policy explicit_network

workspace SuiteJAOPS_02613 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_93 replicas 2
    health_check worker_93 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_02613.msslb"