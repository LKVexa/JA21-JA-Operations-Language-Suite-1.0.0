ja source 0.3
module corpus.ja_operations.example_08609
use Operations
policy explicit_network

workspace SuiteJAOPS_08609 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_75 replicas 2
    health_check worker_75 every 28s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08609.msslb"