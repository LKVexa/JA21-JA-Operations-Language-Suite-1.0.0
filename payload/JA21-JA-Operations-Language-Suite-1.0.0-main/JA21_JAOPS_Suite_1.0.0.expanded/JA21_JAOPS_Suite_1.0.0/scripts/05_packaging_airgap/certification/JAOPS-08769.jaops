module corpus.ja_operations.example_08769
use Operations
policy explicit_network

workspace SuiteJAOPS_08769 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_41 replicas 2
    health_check worker_41 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08769.msslb"