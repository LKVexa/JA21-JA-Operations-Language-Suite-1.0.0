ja source 0.3
module corpus.ja_operations.example_08599
use Operations
policy explicit_network

workspace SuiteJAOPS_08599 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_65 replicas 4
    health_check worker_65 every 18s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08599.msslb"