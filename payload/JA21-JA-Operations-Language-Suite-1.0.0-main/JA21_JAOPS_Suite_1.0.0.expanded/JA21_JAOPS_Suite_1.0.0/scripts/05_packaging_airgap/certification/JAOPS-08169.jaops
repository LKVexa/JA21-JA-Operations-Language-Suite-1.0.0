module corpus.ja_operations.example_08169
use Operations
policy explicit_network

workspace SuiteJAOPS_08169 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_23 replicas 2
    health_check worker_23 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08169.msslb"