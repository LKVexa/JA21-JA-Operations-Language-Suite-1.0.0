module corpus.ja_operations.example_08929
use Operations
policy explicit_network

workspace SuiteJAOPS_08929 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_7 replicas 2
    health_check worker_7 every 7s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08929.msslb"