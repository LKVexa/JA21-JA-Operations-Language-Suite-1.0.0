module corpus.ja_operations.example_08489
use Operations
policy explicit_network

workspace SuiteJAOPS_08489 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_52 replicas 2
    health_check worker_52 every 32s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08489.msslb"