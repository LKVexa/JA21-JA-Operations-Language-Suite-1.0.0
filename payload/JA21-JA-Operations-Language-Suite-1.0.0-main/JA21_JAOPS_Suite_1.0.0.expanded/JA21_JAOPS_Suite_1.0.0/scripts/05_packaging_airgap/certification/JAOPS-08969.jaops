module corpus.ja_operations.example_08969
use Operations
policy explicit_network

workspace SuiteJAOPS_08969 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_47 replicas 2
    health_check worker_47 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08969.msslb"