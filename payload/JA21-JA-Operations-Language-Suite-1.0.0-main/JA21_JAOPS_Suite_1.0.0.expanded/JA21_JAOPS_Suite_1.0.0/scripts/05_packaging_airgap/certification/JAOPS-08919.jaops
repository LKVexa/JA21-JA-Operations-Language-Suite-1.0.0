module corpus.ja_operations.example_08919
use Operations
policy explicit_network

workspace SuiteJAOPS_08919 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_94 replicas 4
    health_check worker_94 every 28s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08919.msslb"