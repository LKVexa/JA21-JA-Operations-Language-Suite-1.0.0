ja source 0.3
module corpus.ja_operations.example_06017
use Operations
policy explicit_network

workspace SuiteJAOPS_06017 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_5 replicas 2
    health_check worker_5 every 9s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06017.msslb"