module corpus.ja_operations.example_06817
use Operations
policy explicit_network

workspace SuiteJAOPS_06817 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_29 replicas 2
    health_check worker_29 every 34s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06817.msslb"