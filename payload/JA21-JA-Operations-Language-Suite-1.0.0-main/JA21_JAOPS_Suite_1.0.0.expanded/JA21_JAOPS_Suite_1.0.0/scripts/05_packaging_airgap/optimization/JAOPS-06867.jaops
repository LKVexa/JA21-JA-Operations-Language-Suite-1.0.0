module corpus.ja_operations.example_06867
use Operations
policy explicit_network

workspace SuiteJAOPS_06867 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_79 replicas 4
    health_check worker_79 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06867.msslb"