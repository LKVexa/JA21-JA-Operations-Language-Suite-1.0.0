ja source 0.3
module corpus.ja_operations.example_01772
use Operations
policy explicit_network

workspace SuiteJAOPS_01772 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_28 replicas 1
    health_check worker_28 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_01772.msslb"