ja source 0.3
module corpus.ja_operations.example_01932
use Operations
policy explicit_network

workspace SuiteJAOPS_01932 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_91 replicas 1
    health_check worker_91 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01932.msslb"