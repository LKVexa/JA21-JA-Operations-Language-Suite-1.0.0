ja source 0.3
module corpus.ja_operations.example_01412
use Operations
policy explicit_network

workspace SuiteJAOPS_01412 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_56 replicas 1
    health_check worker_56 every 23s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_01412.msslb"