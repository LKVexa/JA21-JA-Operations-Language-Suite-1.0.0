ja source 0.3
module corpus.ja_operations.example_04885
use Operations
policy explicit_network

workspace SuiteJAOPS_04885 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_37 replicas 2
    health_check worker_37 every 24s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_04885.msslb"