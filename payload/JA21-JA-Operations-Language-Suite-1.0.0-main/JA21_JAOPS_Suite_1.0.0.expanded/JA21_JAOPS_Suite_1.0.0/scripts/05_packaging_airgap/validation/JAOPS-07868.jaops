module corpus.ja_operations.example_07868
use Operations
policy explicit_network

workspace SuiteJAOPS_07868 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_13 replicas 1
    health_check worker_13 every 31s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07868.msslb"