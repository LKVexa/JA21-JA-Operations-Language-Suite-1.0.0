module corpus.ja_operations.example_07598
use Operations
policy explicit_network

workspace SuiteJAOPS_07598 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_34 replicas 3
    health_check worker_34 every 9s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07598.msslb"