ja source 0.3
module corpus.ja_operations.example_07118
use Operations
policy explicit_network

workspace SuiteJAOPS_07118 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_39 replicas 3
    health_check worker_39 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07118.msslb"