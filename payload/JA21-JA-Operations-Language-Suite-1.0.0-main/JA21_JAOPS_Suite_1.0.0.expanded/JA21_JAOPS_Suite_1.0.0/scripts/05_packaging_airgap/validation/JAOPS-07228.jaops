ja source 0.3
module corpus.ja_operations.example_07228
use Operations
policy explicit_network

workspace SuiteJAOPS_07228 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_52 replicas 1
    health_check worker_52 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07228.msslb"