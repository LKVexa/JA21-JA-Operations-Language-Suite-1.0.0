ja source 0.3
module corpus.ja_operations.example_00421
use Operations
policy explicit_network

workspace SuiteJAOPS_00421 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_35 replicas 2
    health_check worker_35 every 24s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00421.msslb"