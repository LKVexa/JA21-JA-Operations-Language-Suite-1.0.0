ja source 0.3
module corpus.ja_operations.example_00951
use Operations
policy explicit_network

workspace SuiteJAOPS_00951 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_80 replicas 4
    health_check worker_80 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00951.msslb"