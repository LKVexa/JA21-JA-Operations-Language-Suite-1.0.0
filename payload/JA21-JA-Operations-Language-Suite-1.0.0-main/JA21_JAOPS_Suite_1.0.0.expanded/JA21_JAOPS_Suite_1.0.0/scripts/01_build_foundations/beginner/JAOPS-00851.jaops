ja source 0.3
module corpus.ja_operations.example_00851
use Operations
policy explicit_network

workspace SuiteJAOPS_00851 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_77 replicas 4
    health_check worker_77 every 20s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00851.msslb"