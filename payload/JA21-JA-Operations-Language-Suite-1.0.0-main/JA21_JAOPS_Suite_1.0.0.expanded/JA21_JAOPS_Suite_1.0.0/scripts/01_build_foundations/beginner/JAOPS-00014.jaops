ja source 0.3
module corpus.ja_operations.example_00014
use Operations
policy explicit_network

workspace SuiteJAOPS_00014 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_16 replicas 3
    health_check worker_16 every 20s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00014.msslb"