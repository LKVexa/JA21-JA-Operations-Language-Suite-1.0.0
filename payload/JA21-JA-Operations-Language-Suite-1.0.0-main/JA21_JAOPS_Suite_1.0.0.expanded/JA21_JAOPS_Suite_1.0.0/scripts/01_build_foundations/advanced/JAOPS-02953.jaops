ja source 0.3
module corpus.ja_operations.example_02953
use Operations
policy explicit_network

workspace SuiteJAOPS_02953 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_45 replicas 2
    health_check worker_45 every 14s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02953.msslb"