module corpus.ja_operations.example_02363
use Operations
policy explicit_network

workspace SuiteJAOPS_02363 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_37 replicas 4
    health_check worker_37 every 13s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_02363.msslb"