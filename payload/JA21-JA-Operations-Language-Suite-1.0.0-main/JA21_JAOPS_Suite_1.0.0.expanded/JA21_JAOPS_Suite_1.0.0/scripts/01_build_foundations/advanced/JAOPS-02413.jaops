ja source 0.3
module corpus.ja_operations.example_02413
use Operations
policy explicit_network

workspace SuiteJAOPS_02413 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_87 replicas 2
    health_check worker_87 every 32s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02413.msslb"