ja source 0.3
module corpus.ja_operations.example_02313
use Operations
policy explicit_network

workspace SuiteJAOPS_02313 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_84 replicas 2
    health_check worker_84 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_02313.msslb"