module corpus.ja_operations.example_02473
use Operations
policy explicit_network

workspace SuiteJAOPS_02473 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_50 replicas 2
    health_check worker_50 every 30s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02473.msslb"