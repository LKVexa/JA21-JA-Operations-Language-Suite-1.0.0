module corpus.ja_operations.example_02793
use Operations
policy explicit_network

workspace SuiteJAOPS_02793 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_79 replicas 2
    health_check worker_79 every 9s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02793.msslb"