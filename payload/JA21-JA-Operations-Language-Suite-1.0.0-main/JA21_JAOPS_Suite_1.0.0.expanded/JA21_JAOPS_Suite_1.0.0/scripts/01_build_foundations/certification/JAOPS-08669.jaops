module corpus.ja_operations.example_08669
use Operations
policy explicit_network

workspace SuiteJAOPS_08669 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_38 replicas 2
    health_check worker_38 every 26s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08669.msslb"