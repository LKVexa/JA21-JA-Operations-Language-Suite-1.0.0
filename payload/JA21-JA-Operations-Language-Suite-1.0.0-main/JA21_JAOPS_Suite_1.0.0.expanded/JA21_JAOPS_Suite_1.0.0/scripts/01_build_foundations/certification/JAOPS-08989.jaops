module corpus.ja_operations.example_08989
use Operations
policy explicit_network

workspace SuiteJAOPS_08989 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_67 replicas 2
    health_check worker_67 every 36s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08989.msslb"