module corpus.ja_operations.example_08239
use Operations
policy explicit_network

workspace SuiteJAOPS_08239 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_93 replicas 4
    health_check worker_93 every 30s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08239.msslb"