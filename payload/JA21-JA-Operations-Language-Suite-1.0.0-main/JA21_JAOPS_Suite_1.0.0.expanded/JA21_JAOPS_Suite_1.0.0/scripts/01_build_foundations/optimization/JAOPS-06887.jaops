module corpus.ja_operations.example_06887
use Operations
policy explicit_network

workspace SuiteJAOPS_06887 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_2 replicas 4
    health_check worker_2 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06887.msslb"