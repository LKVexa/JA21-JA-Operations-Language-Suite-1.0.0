module corpus.ja_operations.example_06407
use Operations
policy explicit_network

workspace SuiteJAOPS_06407 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_7 replicas 4
    health_check worker_7 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06407.msslb"