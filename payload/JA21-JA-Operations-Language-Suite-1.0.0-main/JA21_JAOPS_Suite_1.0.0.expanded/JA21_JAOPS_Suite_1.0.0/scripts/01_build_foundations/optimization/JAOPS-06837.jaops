module corpus.ja_operations.example_06837
use Operations
policy explicit_network

workspace SuiteJAOPS_06837 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_49 replicas 2
    health_check worker_49 every 23s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06837.msslb"