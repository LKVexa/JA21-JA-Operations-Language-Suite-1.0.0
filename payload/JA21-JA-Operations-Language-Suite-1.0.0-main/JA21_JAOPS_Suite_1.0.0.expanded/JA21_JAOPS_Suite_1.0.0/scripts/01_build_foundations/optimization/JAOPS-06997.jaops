ja source 0.3
module corpus.ja_operations.example_06997
use Operations
policy explicit_network

workspace SuiteJAOPS_06997 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_15 replicas 2
    health_check worker_15 every 28s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06997.msslb"