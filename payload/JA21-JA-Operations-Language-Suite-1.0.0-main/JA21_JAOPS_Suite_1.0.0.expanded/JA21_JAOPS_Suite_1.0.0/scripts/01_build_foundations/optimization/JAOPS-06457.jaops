module corpus.ja_operations.example_06457
use Operations
policy explicit_network

workspace SuiteJAOPS_06457 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_57 replicas 2
    health_check worker_57 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06457.msslb"