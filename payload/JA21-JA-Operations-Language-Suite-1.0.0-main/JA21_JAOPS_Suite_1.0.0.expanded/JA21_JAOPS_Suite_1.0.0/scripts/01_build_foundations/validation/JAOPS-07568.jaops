module corpus.ja_operations.example_07568
use Operations
policy explicit_network

workspace SuiteJAOPS_07568 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_4 replicas 1
    health_check worker_4 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07568.msslb"