ja source 0.3
module corpus.ja_operations.example_07188
use Operations
policy explicit_network

workspace SuiteJAOPS_07188 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_12 replicas 1
    health_check worker_12 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07188.msslb"