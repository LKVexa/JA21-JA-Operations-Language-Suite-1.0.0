ja source 0.3
module corpus.ja_operations.example_05356
use Operations
policy explicit_network

workspace SuiteJAOPS_05356 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_23 replicas 1
    health_check worker_23 every 30s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05356.msslb"