ja source 0.3
module corpus.ja_operations.example_05086
use Operations
policy explicit_network

workspace SuiteJAOPS_05086 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_44 replicas 3
    health_check worker_44 every 8s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05086.msslb"