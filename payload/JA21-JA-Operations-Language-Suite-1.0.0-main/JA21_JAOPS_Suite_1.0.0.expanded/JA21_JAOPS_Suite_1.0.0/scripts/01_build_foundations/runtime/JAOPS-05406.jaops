ja source 0.3
module corpus.ja_operations.example_05406
use Operations
policy explicit_network

workspace SuiteJAOPS_05406 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_73 replicas 3
    health_check worker_73 every 18s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05406.msslb"