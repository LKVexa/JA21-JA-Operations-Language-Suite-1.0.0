ja source 0.3
module corpus.ja_operations.example_05946
use Operations
policy explicit_network

workspace SuiteJAOPS_05946 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_31 replicas 3
    health_check worker_31 every 31s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05946.msslb"