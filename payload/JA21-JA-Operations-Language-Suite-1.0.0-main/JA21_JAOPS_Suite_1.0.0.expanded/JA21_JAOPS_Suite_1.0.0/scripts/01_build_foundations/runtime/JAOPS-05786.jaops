module corpus.ja_operations.example_05786
use Operations
policy explicit_network

workspace SuiteJAOPS_05786 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_65 replicas 3
    health_check worker_65 every 26s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05786.msslb"