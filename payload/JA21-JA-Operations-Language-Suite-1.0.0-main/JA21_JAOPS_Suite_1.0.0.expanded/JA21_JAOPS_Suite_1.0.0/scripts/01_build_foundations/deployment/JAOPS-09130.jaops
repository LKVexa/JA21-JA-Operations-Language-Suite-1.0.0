module corpus.ja_operations.example_09130
use Operations
policy explicit_network

workspace SuiteJAOPS_09130 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_14 replicas 3
    health_check worker_14 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09130.msslb"