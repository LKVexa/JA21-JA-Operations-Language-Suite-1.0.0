ja source 0.3
module corpus.ja_operations.example_09930
use Operations
policy explicit_network

workspace SuiteJAOPS_09930 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_38 replicas 3
    health_check worker_38 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09930.msslb"