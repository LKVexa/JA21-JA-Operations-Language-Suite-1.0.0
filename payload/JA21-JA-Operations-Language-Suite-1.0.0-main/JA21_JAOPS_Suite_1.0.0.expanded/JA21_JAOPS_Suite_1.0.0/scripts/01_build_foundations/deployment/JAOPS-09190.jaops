module corpus.ja_operations.example_09190
use Operations
policy explicit_network

workspace SuiteJAOPS_09190 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_74 replicas 3
    health_check worker_74 every 20s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09190.msslb"