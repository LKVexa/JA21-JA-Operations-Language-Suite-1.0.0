ja source 0.3
module corpus.ja_operations.example_09400
use Operations
policy explicit_network

workspace SuiteJAOPS_09400 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_90 replicas 1
    health_check worker_90 every 13s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09400.msslb"