ja source 0.3
module corpus.ja_operations.example_09610
use Operations
policy explicit_network

workspace SuiteJAOPS_09610 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_9 replicas 3
    health_check worker_9 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09610.msslb"