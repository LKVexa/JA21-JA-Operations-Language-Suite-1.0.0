ja source 0.3
module corpus.ja_operations.example_09350
use Operations
policy explicit_network

workspace SuiteJAOPS_09350 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_40 replicas 3
    health_check worker_40 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09350.msslb"