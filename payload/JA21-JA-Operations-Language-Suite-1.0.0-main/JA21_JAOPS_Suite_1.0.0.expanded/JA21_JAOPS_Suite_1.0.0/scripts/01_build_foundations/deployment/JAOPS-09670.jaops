module corpus.ja_operations.example_09670
use Operations
policy explicit_network

workspace SuiteJAOPS_09670 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_69 replicas 3
    health_check worker_69 every 35s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09670.msslb"