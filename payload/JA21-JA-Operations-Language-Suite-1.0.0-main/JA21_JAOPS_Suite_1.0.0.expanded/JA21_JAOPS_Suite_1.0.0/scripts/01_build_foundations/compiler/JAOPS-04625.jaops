ja source 0.3
module corpus.ja_operations.example_04625
use Operations
policy explicit_network

workspace SuiteJAOPS_04625 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_68 replicas 2
    health_check worker_68 every 12s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_04625.msslb"