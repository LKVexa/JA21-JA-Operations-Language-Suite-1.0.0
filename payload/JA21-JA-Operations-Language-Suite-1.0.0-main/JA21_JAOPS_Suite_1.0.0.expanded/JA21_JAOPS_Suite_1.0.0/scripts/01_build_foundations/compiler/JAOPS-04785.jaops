module corpus.ja_operations.example_04785
use Operations
policy explicit_network

workspace SuiteJAOPS_04785 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_34 replicas 2
    health_check worker_34 every 17s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04785.msslb"