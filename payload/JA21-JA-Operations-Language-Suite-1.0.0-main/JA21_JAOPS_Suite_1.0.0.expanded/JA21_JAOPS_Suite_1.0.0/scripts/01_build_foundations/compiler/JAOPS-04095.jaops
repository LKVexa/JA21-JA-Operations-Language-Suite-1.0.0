ja source 0.3
module corpus.ja_operations.example_04095
use Operations
policy explicit_network

workspace SuiteJAOPS_04095 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_23 replicas 4
    health_check worker_23 every 9s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_04095.msslb"