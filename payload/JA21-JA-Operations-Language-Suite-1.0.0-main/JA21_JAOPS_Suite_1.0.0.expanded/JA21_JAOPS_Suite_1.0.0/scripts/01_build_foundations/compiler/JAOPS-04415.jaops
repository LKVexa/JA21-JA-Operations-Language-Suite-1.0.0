ja source 0.3
module corpus.ja_operations.example_04415
use Operations
policy explicit_network

workspace SuiteJAOPS_04415 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_52 replicas 4
    health_check worker_52 every 19s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04415.msslb"