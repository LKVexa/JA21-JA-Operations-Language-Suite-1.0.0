ja source 0.3
module corpus.ja_operations.example_01902
use Operations
policy explicit_network

workspace SuiteJAOPS_01902 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_61 replicas 3
    health_check worker_61 every 17s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01902.msslb"