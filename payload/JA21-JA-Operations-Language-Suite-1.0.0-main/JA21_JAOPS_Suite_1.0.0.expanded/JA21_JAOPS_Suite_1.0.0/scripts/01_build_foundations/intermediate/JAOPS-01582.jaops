ja source 0.3
module corpus.ja_operations.example_01582
use Operations
policy explicit_network

workspace SuiteJAOPS_01582 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_32 replicas 3
    health_check worker_32 every 7s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01582.msslb"