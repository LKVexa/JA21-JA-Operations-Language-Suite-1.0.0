module corpus.ja_operations.example_03844
use Operations
policy explicit_network

workspace SuiteJAOPS_03844 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_63 replicas 1
    health_check worker_63 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03844.msslb"