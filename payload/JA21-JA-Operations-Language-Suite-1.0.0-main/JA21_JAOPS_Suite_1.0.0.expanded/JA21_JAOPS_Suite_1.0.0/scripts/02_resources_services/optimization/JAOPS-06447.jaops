module corpus.ja_operations.example_06447
use Operations
policy explicit_network

workspace SuiteJAOPS_06447 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_47 replicas 4
    health_check worker_47 every 36s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06447.msslb"