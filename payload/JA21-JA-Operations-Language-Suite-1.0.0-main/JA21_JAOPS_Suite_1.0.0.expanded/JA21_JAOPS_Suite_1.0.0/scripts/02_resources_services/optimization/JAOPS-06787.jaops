module corpus.ja_operations.example_06787
use Operations
policy explicit_network

workspace SuiteJAOPS_06787 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_96 replicas 4
    health_check worker_96 every 35s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06787.msslb"