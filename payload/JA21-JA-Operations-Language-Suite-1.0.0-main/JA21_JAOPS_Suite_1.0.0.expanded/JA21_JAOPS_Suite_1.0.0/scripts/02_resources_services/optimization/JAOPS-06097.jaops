ja source 0.3
module corpus.ja_operations.example_06097
use Operations
policy explicit_network

workspace SuiteJAOPS_06097 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_85 replicas 2
    health_check worker_85 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06097.msslb"