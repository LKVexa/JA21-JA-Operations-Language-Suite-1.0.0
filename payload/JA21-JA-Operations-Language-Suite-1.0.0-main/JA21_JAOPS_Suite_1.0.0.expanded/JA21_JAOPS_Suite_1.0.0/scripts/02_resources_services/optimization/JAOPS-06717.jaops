module corpus.ja_operations.example_06717
use Operations
policy explicit_network

workspace SuiteJAOPS_06717 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_26 replicas 2
    health_check worker_26 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06717.msslb"