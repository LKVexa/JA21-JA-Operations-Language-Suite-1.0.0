ja source 0.3
module corpus.ja_operations.example_00431
use Operations
policy explicit_network

workspace SuiteJAOPS_00431 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_45 replicas 4
    health_check worker_45 every 34s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00431.msslb"