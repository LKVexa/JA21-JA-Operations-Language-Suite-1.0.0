ja source 0.3
module corpus.ja_operations.example_00621
use Operations
policy explicit_network

workspace SuiteJAOPS_00621 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_41 replicas 2
    health_check worker_41 every 7s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00621.msslb"