ja source 0.3
module corpus.ja_operations.example_00481
use Operations
policy explicit_network

workspace SuiteJAOPS_00481 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_95 replicas 2
    health_check worker_95 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00481.msslb"