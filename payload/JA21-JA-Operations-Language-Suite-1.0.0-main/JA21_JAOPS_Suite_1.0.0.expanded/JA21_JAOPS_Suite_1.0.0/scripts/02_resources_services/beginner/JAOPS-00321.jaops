ja source 0.3
module corpus.ja_operations.example_00321
use Operations
policy explicit_network

workspace SuiteJAOPS_00321 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_32 replicas 2
    health_check worker_32 every 17s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00321.msslb"