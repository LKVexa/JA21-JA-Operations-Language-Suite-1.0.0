module corpus.ja_operations.example_09440
use Operations
policy explicit_network

workspace SuiteJAOPS_09440 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_33 replicas 1
    health_check worker_33 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_09440.msslb"