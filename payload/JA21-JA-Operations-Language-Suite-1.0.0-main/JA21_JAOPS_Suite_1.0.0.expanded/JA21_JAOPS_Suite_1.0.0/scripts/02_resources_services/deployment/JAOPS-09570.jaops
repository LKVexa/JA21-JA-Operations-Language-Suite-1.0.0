module corpus.ja_operations.example_09570
use Operations
policy explicit_network

workspace SuiteJAOPS_09570 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 6GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_66 replicas 3
    health_check worker_66 every 28s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09570.msslb"