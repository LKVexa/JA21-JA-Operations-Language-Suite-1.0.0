ja source 0.3
module corpus.ja_operations.example_09870
use Operations
policy explicit_network

workspace SuiteJAOPS_09870 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_75 replicas 3
    health_check worker_75 every 18s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09870.msslb"