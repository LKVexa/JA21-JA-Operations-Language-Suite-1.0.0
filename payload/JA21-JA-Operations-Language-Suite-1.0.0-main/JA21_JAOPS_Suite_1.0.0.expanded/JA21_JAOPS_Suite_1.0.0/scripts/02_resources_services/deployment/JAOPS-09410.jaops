ja source 0.3
module corpus.ja_operations.example_09410
use Operations
policy explicit_network

workspace SuiteJAOPS_09410 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 6GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_3 replicas 3
    health_check worker_3 every 23s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_09410.msslb"