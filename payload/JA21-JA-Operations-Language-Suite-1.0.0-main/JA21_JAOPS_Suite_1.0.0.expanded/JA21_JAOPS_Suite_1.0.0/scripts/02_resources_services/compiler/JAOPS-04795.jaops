module corpus.ja_operations.example_04795
use Operations
policy explicit_network

workspace SuiteJAOPS_04795 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_44 replicas 4
    health_check worker_44 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04795.msslb"