ja source 0.3
module corpus.ja_operations.example_04775
use Operations
policy explicit_network

workspace SuiteJAOPS_04775 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_24 replicas 4
    health_check worker_24 every 7s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04775.msslb"