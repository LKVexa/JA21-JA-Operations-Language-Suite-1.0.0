ja source 0.3
module corpus.ja_operations.example_04475
use Operations
policy explicit_network

workspace SuiteJAOPS_04475 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_15 replicas 4
    health_check worker_15 every 17s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04475.msslb"