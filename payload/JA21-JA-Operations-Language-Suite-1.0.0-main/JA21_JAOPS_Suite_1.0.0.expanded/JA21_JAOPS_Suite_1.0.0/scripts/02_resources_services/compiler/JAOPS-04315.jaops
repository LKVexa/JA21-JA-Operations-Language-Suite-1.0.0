module corpus.ja_operations.example_04315
use Operations
policy explicit_network

workspace SuiteJAOPS_04315 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_49 replicas 4
    health_check worker_49 every 12s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_04315.msslb"