ja source 0.3
module corpus.ja_operations.example_07518
use Operations
policy explicit_network

workspace SuiteJAOPS_07518 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_51 replicas 3
    health_check worker_51 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07518.msslb"