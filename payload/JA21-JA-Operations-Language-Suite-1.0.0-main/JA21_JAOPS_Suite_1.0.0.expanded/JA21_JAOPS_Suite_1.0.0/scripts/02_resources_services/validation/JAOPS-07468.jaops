ja source 0.3
module corpus.ja_operations.example_07468
use Operations
policy explicit_network

workspace SuiteJAOPS_07468 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_98 replicas 1
    health_check worker_98 every 34s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07468.msslb"