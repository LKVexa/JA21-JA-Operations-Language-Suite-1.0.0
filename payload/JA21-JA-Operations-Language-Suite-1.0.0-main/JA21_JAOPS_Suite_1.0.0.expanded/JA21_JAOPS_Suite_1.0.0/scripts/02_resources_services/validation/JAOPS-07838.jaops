module corpus.ja_operations.example_07838
use Operations
policy explicit_network

workspace SuiteJAOPS_07838 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_80 replicas 3
    health_check worker_80 every 32s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07838.msslb"