ja source 0.3
module corpus.ja_operations.example_07608
use Operations
policy explicit_network

workspace SuiteJAOPS_07608 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_44 replicas 1
    health_check worker_44 every 19s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07608.msslb"