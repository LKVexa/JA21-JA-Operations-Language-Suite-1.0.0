module corpus.ja_operations.example_07788
use Operations
policy explicit_network

workspace SuiteJAOPS_07788 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_30 replicas 1
    health_check worker_30 every 13s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07788.msslb"