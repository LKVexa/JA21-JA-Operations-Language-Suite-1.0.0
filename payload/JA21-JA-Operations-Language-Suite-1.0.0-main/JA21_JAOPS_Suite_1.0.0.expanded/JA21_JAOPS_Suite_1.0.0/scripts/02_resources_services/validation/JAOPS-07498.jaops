module corpus.ja_operations.example_07498
use Operations
policy explicit_network

workspace SuiteJAOPS_07498 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_31 replicas 3
    health_check worker_31 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07498.msslb"