ja source 0.3
module corpus.ja_operations.example_05896
use Operations
policy explicit_network

workspace SuiteJAOPS_05896 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_78 replicas 1
    health_check worker_78 every 12s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05896.msslb"