ja source 0.3
module corpus.ja_operations.example_01352
use Operations
policy explicit_network

workspace SuiteJAOPS_01352 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_93 replicas 1
    health_check worker_93 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01352.msslb"