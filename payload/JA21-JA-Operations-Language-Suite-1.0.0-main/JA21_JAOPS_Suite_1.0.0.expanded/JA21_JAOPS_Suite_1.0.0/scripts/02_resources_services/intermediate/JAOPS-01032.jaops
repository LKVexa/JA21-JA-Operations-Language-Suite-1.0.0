module corpus.ja_operations.example_01032
use Operations
policy explicit_network

workspace SuiteJAOPS_01032 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_64 replicas 1
    health_check worker_64 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01032.msslb"