ja source 0.3
module corpus.ja_operations.example_01622
use Operations
policy explicit_network

workspace SuiteJAOPS_01622 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_72 replicas 3
    health_check worker_72 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01622.msslb"