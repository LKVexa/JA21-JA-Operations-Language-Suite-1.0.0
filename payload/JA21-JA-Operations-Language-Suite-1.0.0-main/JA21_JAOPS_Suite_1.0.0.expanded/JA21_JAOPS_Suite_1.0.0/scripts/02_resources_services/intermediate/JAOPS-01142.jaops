ja source 0.3
module corpus.ja_operations.example_01142
use Operations
policy explicit_network

workspace SuiteJAOPS_01142 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_77 replicas 3
    health_check worker_77 every 32s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01142.msslb"