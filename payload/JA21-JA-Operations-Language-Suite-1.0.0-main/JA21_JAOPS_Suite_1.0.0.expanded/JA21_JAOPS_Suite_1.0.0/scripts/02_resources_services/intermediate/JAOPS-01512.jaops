ja source 0.3
module corpus.ja_operations.example_01512
use Operations
policy explicit_network

workspace SuiteJAOPS_01512 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_59 replicas 1
    health_check worker_59 every 30s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_01512.msslb"