ja source 0.3
module corpus.ja_operations.example_08999
use Operations
policy explicit_network

workspace SuiteJAOPS_08999 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_77 replicas 4
    health_check worker_77 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08999.msslb"