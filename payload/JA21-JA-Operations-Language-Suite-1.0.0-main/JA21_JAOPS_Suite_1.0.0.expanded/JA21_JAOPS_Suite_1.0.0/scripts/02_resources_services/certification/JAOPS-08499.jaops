module corpus.ja_operations.example_08499
use Operations
policy explicit_network

workspace SuiteJAOPS_08499 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_62 replicas 4
    health_check worker_62 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08499.msslb"