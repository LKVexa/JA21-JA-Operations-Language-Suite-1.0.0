module corpus.ja_operations.example_08839
use Operations
policy explicit_network

workspace SuiteJAOPS_08839 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_14 replicas 4
    health_check worker_14 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08839.msslb"