module corpus.ja_operations.example_08869
use Operations
policy explicit_network

workspace SuiteJAOPS_08869 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_44 replicas 2
    health_check worker_44 every 9s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08869.msslb"