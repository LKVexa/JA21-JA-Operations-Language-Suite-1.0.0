module corpus.ja_operations.example_08729
use Operations
policy explicit_network

workspace SuiteJAOPS_08729 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_98 replicas 2
    health_check worker_98 every 24s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08729.msslb"