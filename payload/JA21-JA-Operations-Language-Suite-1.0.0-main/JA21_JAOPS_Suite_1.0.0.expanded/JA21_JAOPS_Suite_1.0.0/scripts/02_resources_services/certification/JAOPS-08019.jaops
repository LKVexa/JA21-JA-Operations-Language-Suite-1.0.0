ja source 0.3
module corpus.ja_operations.example_08019
use Operations
policy explicit_network

workspace SuiteJAOPS_08019 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_67 replicas 4
    health_check worker_67 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08019.msslb"