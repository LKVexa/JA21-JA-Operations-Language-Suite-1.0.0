module corpus.ja_operations.example_08889
use Operations
policy explicit_network

workspace SuiteJAOPS_08889 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_64 replicas 2
    health_check worker_64 every 29s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08889.msslb"