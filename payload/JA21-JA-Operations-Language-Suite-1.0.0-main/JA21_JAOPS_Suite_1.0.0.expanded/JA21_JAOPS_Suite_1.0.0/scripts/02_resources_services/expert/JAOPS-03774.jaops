module corpus.ja_operations.example_03774
use Operations
policy explicit_network

workspace SuiteJAOPS_03774 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_90 replicas 3
    health_check worker_90 every 29s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_03774.msslb"