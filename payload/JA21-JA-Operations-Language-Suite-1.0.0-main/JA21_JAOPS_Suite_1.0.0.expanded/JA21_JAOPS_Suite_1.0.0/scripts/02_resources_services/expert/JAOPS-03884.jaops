module corpus.ja_operations.example_03884
use Operations
policy explicit_network

workspace SuiteJAOPS_03884 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_6 replicas 1
    health_check worker_6 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03884.msslb"