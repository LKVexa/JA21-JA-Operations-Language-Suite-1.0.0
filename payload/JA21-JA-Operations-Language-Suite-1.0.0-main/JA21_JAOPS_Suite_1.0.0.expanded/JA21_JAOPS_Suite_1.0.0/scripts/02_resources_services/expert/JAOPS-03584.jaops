module corpus.ja_operations.example_03584
use Operations
policy explicit_network

workspace SuiteJAOPS_03584 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_94 replicas 1
    health_check worker_94 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03584.msslb"