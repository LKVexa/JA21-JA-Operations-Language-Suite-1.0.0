module corpus.ja_operations.example_03294
use Operations
policy explicit_network

workspace SuiteJAOPS_03294 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_95 replicas 3
    health_check worker_95 every 14s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03294.msslb"