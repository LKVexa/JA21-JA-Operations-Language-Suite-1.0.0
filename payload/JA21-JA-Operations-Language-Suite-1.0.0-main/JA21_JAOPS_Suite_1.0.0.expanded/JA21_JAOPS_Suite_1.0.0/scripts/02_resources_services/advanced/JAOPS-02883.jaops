module corpus.ja_operations.example_02883
use Operations
policy explicit_network

workspace SuiteJAOPS_02883 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_72 replicas 4
    health_check worker_72 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_02883.msslb"