ja source 0.3
module corpus.ja_operations.example_08699
use Operations
policy explicit_network

workspace SuiteJAOPS_08699 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_68 replicas 4
    health_check worker_68 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08699.msslb"