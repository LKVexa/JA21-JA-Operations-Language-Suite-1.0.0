module corpus.ja_operations.example_08959
use Operations
policy explicit_network

workspace SuiteJAOPS_08959 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_37 replicas 4
    health_check worker_37 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08959.msslb"