ja source 0.3
module corpus.ja_operations.example_08049
use Operations
policy explicit_network

workspace SuiteJAOPS_08049 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_97 replicas 2
    health_check worker_97 every 26s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08049.msslb"