module corpus.ja_operations.example_08689
use Operations
policy explicit_network

workspace SuiteJAOPS_08689 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_58 replicas 2
    health_check worker_58 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08689.msslb"