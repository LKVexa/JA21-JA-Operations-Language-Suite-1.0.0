module corpus.ja_operations.example_08369
use Operations
policy explicit_network

workspace SuiteJAOPS_08369 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_29 replicas 2
    health_check worker_29 every 36s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08369.msslb"