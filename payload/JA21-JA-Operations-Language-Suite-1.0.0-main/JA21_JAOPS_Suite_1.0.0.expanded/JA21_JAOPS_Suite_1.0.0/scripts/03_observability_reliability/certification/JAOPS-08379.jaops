module corpus.ja_operations.example_08379
use Operations
policy explicit_network

workspace SuiteJAOPS_08379 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_39 replicas 4
    health_check worker_39 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08379.msslb"