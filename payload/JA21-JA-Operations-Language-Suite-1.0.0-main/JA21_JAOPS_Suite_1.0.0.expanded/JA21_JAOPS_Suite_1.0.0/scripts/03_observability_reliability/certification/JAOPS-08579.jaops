ja source 0.3
module corpus.ja_operations.example_08579
use Operations
policy explicit_network

workspace SuiteJAOPS_08579 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_45 replicas 4
    health_check worker_45 every 29s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08579.msslb"