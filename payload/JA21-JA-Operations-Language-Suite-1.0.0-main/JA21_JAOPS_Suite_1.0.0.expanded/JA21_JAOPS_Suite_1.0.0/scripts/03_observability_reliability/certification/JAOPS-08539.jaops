module corpus.ja_operations.example_08539
use Operations
policy explicit_network

workspace SuiteJAOPS_08539 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_5 replicas 4
    health_check worker_5 every 20s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08539.msslb"