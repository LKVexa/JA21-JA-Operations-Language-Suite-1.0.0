ja source 0.3
module corpus.ja_operations.example_08219
use Operations
policy explicit_network

workspace SuiteJAOPS_08219 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_73 replicas 4
    health_check worker_73 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08219.msslb"