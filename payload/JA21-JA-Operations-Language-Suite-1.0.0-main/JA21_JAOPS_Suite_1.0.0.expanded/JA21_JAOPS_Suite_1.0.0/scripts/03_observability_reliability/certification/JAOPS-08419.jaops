ja source 0.3
module corpus.ja_operations.example_08419
use Operations
policy explicit_network

workspace SuiteJAOPS_08419 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_79 replicas 4
    health_check worker_79 every 24s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08419.msslb"