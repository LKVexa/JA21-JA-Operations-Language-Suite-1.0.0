ja source 0.3
module corpus.ja_operations.example_02753
use Operations
policy explicit_network

workspace SuiteJAOPS_02753 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_39 replicas 2
    health_check worker_39 every 31s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02753.msslb"