ja source 0.3
module corpus.ja_operations.example_02433
use Operations
policy explicit_network

workspace SuiteJAOPS_02433 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_10 replicas 2
    health_check worker_10 every 21s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02433.msslb"