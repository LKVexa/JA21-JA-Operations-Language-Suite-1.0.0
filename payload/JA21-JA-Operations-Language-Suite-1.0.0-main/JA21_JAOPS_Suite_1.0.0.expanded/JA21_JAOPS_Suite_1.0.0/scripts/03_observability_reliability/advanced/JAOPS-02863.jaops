ja source 0.3
module corpus.ja_operations.example_02863
use Operations
policy explicit_network

workspace SuiteJAOPS_02863 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_52 replicas 4
    health_check worker_52 every 17s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_02863.msslb"