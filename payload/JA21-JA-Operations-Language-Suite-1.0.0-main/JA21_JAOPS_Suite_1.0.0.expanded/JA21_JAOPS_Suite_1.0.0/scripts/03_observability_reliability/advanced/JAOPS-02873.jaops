ja source 0.3
module corpus.ja_operations.example_02873
use Operations
policy explicit_network

workspace SuiteJAOPS_02873 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_62 replicas 2
    health_check worker_62 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_02873.msslb"