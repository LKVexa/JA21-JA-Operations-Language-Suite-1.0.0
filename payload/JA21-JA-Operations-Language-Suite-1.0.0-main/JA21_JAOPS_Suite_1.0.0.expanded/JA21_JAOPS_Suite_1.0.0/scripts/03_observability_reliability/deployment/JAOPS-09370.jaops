module corpus.ja_operations.example_09370
use Operations
policy explicit_network

workspace SuiteJAOPS_09370 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_60 replicas 3
    health_check worker_60 every 14s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09370.msslb"