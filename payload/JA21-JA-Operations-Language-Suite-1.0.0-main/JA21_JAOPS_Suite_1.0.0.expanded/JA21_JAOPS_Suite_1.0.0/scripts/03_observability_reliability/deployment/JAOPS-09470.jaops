module corpus.ja_operations.example_09470
use Operations
policy explicit_network

workspace SuiteJAOPS_09470 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_63 replicas 3
    health_check worker_63 every 21s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_09470.msslb"