ja source 0.3
module corpus.ja_operations.example_09850
use Operations
policy explicit_network

workspace SuiteJAOPS_09850 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_55 replicas 3
    health_check worker_55 every 29s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09850.msslb"