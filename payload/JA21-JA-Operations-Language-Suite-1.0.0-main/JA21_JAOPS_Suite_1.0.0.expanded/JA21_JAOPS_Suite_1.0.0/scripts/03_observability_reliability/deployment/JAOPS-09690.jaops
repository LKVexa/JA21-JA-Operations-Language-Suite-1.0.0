ja source 0.3
module corpus.ja_operations.example_09690
use Operations
policy explicit_network

workspace SuiteJAOPS_09690 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_89 replicas 3
    health_check worker_89 every 24s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_09690.msslb"