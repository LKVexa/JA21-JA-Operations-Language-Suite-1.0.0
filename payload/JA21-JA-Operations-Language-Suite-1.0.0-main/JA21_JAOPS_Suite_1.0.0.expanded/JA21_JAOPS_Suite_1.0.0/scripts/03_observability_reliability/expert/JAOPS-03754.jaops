module corpus.ja_operations.example_03754
use Operations
policy explicit_network

workspace SuiteJAOPS_03754 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_70 replicas 3
    health_check worker_70 every 9s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_03754.msslb"