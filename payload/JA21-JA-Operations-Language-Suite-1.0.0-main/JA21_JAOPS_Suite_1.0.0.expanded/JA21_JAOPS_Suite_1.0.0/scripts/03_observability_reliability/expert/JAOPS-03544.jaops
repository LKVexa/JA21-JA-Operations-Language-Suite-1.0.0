module corpus.ja_operations.example_03544
use Operations
policy explicit_network

workspace SuiteJAOPS_03544 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_54 replicas 1
    health_check worker_54 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_03544.msslb"