module corpus.ja_operations.example_03384
use Operations
policy explicit_network

workspace SuiteJAOPS_03384 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_88 replicas 1
    health_check worker_88 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03384.msslb"