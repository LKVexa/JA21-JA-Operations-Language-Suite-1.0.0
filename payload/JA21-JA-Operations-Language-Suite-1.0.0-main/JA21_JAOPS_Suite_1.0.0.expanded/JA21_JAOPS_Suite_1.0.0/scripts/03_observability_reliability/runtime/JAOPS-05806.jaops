module corpus.ja_operations.example_05806
use Operations
policy explicit_network

workspace SuiteJAOPS_05806 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_85 replicas 3
    health_check worker_85 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05806.msslb"