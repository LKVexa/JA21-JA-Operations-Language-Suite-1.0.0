ja source 0.3
module corpus.ja_operations.example_05696
use Operations
policy explicit_network

workspace SuiteJAOPS_05696 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_72 replicas 1
    health_check worker_72 every 29s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05696.msslb"