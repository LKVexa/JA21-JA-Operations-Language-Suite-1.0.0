ja source 0.3
module corpus.ja_operations.example_05106
use Operations
policy explicit_network

workspace SuiteJAOPS_05106 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 6GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_64 replicas 3
    health_check worker_64 every 28s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05106.msslb"