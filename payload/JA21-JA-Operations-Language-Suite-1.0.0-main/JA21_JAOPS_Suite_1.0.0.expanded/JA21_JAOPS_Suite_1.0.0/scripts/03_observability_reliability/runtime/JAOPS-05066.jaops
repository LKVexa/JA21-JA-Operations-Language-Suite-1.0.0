ja source 0.3
module corpus.ja_operations.example_05066
use Operations
policy explicit_network

workspace SuiteJAOPS_05066 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_24 replicas 3
    health_check worker_24 every 19s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_05066.msslb"