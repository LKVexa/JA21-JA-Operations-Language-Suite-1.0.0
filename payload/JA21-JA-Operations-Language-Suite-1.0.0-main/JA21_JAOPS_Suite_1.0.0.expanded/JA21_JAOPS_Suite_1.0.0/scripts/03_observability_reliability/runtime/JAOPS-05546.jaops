module corpus.ja_operations.example_05546
use Operations
policy explicit_network

workspace SuiteJAOPS_05546 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_19 replicas 3
    health_check worker_19 every 34s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05546.msslb"