ja source 0.3
module corpus.ja_operations.example_00771
use Operations
policy explicit_network

workspace SuiteJAOPS_00771 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_94 replicas 4
    health_check worker_94 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00771.msslb"