ja source 0.3
module corpus.ja_operations.example_00281
use Operations
policy explicit_network

workspace SuiteJAOPS_00281 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_89 replicas 2
    health_check worker_89 every 8s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00281.msslb"