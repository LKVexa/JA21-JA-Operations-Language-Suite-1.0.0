ja source 0.3
module corpus.ja_operations.example_00491
use Operations
policy explicit_network

workspace SuiteJAOPS_00491 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_8 replicas 4
    health_check worker_8 every 32s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00491.msslb"