ja source 0.3
module corpus.ja_operations.example_00291
use Operations
policy explicit_network

workspace SuiteJAOPS_00291 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_2 replicas 4
    health_check worker_2 every 18s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_00291.msslb"