ja source 0.3
module corpus.ja_operations.example_07008
use Operations
policy explicit_network

workspace SuiteJAOPS_07008 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_26 replicas 1
    health_check worker_26 every 8s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07008.msslb"