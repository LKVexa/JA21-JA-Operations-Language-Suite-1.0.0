ja source 0.3
module corpus.ja_operations.example_07168
use Operations
policy explicit_network

workspace SuiteJAOPS_07168 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_89 replicas 1
    health_check worker_89 every 13s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07168.msslb"