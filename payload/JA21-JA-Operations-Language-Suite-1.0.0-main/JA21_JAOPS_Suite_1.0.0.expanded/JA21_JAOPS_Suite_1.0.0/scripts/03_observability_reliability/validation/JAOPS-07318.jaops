ja source 0.3
module corpus.ja_operations.example_07318
use Operations
policy explicit_network

workspace SuiteJAOPS_07318 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_45 replicas 3
    health_check worker_45 every 8s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07318.msslb"