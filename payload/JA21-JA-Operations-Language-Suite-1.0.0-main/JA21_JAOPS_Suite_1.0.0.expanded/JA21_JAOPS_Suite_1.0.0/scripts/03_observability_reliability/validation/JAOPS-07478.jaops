module corpus.ja_operations.example_07478
use Operations
policy explicit_network

workspace SuiteJAOPS_07478 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_11 replicas 3
    health_check worker_11 every 13s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07478.msslb"