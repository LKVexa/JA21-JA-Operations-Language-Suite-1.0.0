module corpus.ja_operations.example_07428
use Operations
policy explicit_network

workspace SuiteJAOPS_07428 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_58 replicas 1
    health_check worker_58 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07428.msslb"