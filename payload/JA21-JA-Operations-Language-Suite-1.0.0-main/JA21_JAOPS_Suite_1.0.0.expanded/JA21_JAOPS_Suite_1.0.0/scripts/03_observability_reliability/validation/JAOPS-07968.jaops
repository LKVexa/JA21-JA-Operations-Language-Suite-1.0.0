module corpus.ja_operations.example_07968
use Operations
policy explicit_network

workspace SuiteJAOPS_07968 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_16 replicas 1
    health_check worker_16 every 7s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07968.msslb"