ja source 0.3
module corpus.ja_operations.example_07808
use Operations
policy explicit_network

workspace SuiteJAOPS_07808 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 4GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_50 replicas 1
    health_check worker_50 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07808.msslb"