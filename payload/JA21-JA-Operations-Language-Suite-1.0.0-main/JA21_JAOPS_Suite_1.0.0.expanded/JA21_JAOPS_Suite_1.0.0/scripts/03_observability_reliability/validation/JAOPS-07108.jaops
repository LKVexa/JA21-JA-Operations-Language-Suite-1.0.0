ja source 0.3
module corpus.ja_operations.example_07108
use Operations
policy explicit_network

workspace SuiteJAOPS_07108 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_29 replicas 1
    health_check worker_29 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07108.msslb"