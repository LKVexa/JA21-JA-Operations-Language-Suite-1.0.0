ja source 0.3
module corpus.ja_operations.example_01502
use Operations
policy explicit_network

workspace SuiteJAOPS_01502 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_49 replicas 3
    health_check worker_49 every 20s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_01502.msslb"