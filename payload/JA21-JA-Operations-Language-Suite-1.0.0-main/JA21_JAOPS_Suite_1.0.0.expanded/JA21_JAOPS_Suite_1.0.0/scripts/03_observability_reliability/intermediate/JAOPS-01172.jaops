ja source 0.3
module corpus.ja_operations.example_01172
use Operations
policy explicit_network

workspace SuiteJAOPS_01172 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_10 replicas 1
    health_check worker_10 every 31s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01172.msslb"