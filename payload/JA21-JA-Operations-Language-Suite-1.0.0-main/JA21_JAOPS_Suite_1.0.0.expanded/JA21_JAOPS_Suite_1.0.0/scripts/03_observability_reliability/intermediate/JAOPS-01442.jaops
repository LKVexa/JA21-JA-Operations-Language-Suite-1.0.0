ja source 0.3
module corpus.ja_operations.example_01442
use Operations
policy explicit_network

workspace SuiteJAOPS_01442 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 6GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_86 replicas 3
    health_check worker_86 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_01442.msslb"