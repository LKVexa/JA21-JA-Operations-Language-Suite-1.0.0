ja source 0.3
module corpus.ja_operations.example_01542
use Operations
policy explicit_network

workspace SuiteJAOPS_01542 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_89 replicas 3
    health_check worker_89 every 29s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_01542.msslb"