ja source 0.3
module corpus.ja_operations.example_01602
use Operations
policy explicit_network

workspace SuiteJAOPS_01602 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 6GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_52 replicas 3
    health_check worker_52 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01602.msslb"