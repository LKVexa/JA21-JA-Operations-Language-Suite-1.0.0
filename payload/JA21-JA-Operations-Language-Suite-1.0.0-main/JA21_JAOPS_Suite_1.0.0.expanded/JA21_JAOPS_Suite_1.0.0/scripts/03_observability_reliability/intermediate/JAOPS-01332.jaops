module corpus.ja_operations.example_01332
use Operations
policy explicit_network

workspace SuiteJAOPS_01332 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_73 replicas 1
    health_check worker_73 every 36s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01332.msslb"