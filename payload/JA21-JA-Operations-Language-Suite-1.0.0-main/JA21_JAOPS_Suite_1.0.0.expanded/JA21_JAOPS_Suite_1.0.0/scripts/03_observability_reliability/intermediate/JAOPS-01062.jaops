ja source 0.3
module corpus.ja_operations.example_01062
use Operations
policy explicit_network

workspace SuiteJAOPS_01062 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_94 replicas 3
    health_check worker_94 every 14s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01062.msslb"