ja source 0.3
module corpus.ja_operations.example_01812
use Operations
policy explicit_network

workspace SuiteJAOPS_01812 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_68 replicas 1
    health_check worker_68 every 20s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_01812.msslb"