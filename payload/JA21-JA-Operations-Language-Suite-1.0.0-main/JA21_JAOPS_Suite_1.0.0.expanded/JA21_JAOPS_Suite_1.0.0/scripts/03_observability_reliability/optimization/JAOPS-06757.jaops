module corpus.ja_operations.example_06757
use Operations
policy explicit_network

workspace SuiteJAOPS_06757 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_66 replicas 2
    health_check worker_66 every 36s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06757.msslb"