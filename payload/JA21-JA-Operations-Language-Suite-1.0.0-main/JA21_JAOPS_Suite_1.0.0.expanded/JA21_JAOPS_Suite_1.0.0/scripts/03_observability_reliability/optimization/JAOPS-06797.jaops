module corpus.ja_operations.example_06797
use Operations
policy explicit_network

workspace SuiteJAOPS_06797 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_9 replicas 2
    health_check worker_9 every 14s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06797.msslb"