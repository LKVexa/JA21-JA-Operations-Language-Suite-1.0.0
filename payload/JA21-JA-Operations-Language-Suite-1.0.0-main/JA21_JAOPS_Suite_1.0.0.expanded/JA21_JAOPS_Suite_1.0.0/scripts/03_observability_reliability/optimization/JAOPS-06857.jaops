module corpus.ja_operations.example_06857
use Operations
policy explicit_network

workspace SuiteJAOPS_06857 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_69 replicas 2
    health_check worker_69 every 12s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06857.msslb"