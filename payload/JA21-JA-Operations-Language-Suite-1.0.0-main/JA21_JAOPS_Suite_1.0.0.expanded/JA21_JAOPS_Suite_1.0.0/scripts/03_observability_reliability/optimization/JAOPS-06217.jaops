ja source 0.3
module corpus.ja_operations.example_06217
use Operations
policy explicit_network

workspace SuiteJAOPS_06217 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_11 replicas 2
    health_check worker_11 every 23s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06217.msslb"