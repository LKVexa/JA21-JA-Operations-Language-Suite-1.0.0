ja source 0.3
module corpus.ja_operations.example_06917
use Operations
policy explicit_network

workspace SuiteJAOPS_06917 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_32 replicas 2
    health_check worker_32 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06917.msslb"