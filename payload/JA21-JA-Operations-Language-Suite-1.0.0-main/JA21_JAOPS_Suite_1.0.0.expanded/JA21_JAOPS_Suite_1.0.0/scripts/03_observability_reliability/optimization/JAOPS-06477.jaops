module corpus.ja_operations.example_06477
use Operations
policy explicit_network

workspace SuiteJAOPS_06477 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_77 replicas 2
    health_check worker_77 every 35s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06477.msslb"