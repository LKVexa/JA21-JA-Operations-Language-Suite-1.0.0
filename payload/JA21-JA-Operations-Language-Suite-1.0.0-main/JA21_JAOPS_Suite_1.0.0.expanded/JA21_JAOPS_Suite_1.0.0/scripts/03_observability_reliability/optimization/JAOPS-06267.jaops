module corpus.ja_operations.example_06267
use Operations
policy explicit_network

workspace SuiteJAOPS_06267 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_61 replicas 4
    health_check worker_61 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06267.msslb"