ja source 0.3
module corpus.ja_operations.example_06107
use Operations
policy explicit_network

workspace SuiteJAOPS_06107 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_95 replicas 4
    health_check worker_95 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06107.msslb"