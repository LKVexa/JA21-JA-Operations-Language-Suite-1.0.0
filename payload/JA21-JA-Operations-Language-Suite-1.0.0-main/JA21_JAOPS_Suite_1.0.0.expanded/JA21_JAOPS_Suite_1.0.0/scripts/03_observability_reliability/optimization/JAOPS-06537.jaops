module corpus.ja_operations.example_06537
use Operations
policy explicit_network

workspace SuiteJAOPS_06537 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_40 replicas 2
    health_check worker_40 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06537.msslb"