ja source 0.3
module corpus.ja_operations.example_06057
use Operations
policy explicit_network

workspace SuiteJAOPS_06057 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 13GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_45 replicas 2
    health_check worker_45 every 18s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06057.msslb"