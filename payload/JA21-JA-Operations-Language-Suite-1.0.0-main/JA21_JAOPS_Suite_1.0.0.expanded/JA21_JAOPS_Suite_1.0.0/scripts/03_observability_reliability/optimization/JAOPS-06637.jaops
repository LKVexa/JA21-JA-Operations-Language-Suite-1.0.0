module corpus.ja_operations.example_06637
use Operations
policy explicit_network

workspace SuiteJAOPS_06637 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_43 replicas 2
    health_check worker_43 every 9s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06637.msslb"