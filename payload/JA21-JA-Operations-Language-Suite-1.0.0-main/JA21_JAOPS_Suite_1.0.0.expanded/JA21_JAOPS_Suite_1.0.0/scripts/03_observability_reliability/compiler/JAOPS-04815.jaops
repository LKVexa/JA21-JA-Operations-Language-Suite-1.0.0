module corpus.ja_operations.example_04815
use Operations
policy explicit_network

workspace SuiteJAOPS_04815 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_64 replicas 4
    health_check worker_64 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04815.msslb"