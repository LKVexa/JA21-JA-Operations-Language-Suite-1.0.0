ja source 0.3
module corpus.ja_operations.example_04435
use Operations
policy explicit_network

workspace SuiteJAOPS_04435 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_72 replicas 4
    health_check worker_72 every 8s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04435.msslb"