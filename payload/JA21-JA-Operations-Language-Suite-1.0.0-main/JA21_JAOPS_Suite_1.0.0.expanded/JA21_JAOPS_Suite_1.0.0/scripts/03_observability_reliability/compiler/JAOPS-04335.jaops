ja source 0.3
module corpus.ja_operations.example_04335
use Operations
policy explicit_network

workspace SuiteJAOPS_04335 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_69 replicas 4
    health_check worker_69 every 32s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_04335.msslb"