module corpus.ja_operations.example_04495
use Operations
policy explicit_network

workspace SuiteJAOPS_04495 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 19GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_35 replicas 4
    health_check worker_35 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04495.msslb"