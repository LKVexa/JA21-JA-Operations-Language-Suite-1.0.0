module corpus.ja_operations.example_04485
use Operations
policy explicit_network

workspace SuiteJAOPS_04485 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_25 replicas 2
    health_check worker_25 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_04485.msslb"