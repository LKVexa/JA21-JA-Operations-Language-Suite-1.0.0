ja source 0.3
module corpus.ja_operations.example_09800
use Operations
policy explicit_network

workspace SuiteJAOPS_09800 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_5 replicas 1
    health_check worker_5 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_09800.msslb"