ja source 0.3
module corpus.ja_operations.example_07098
use Operations
policy explicit_network

workspace SuiteJAOPS_07098 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_19 replicas 3
    health_check worker_19 every 36s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_07098.msslb"