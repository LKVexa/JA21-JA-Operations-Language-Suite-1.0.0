module corpus.ja_operations.example_07418
use Operations
policy explicit_network

workspace SuiteJAOPS_07418 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 4 memory 14GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_48 replicas 3
    health_check worker_48 every 15s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_07418.msslb"