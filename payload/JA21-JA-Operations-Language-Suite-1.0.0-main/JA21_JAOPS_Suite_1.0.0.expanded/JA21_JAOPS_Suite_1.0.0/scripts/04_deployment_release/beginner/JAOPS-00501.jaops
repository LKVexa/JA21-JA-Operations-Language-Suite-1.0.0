ja source 0.3
module corpus.ja_operations.example_00501
use Operations
policy explicit_network

workspace SuiteJAOPS_00501 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_18 replicas 2
    health_check worker_18 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_00501.msslb"