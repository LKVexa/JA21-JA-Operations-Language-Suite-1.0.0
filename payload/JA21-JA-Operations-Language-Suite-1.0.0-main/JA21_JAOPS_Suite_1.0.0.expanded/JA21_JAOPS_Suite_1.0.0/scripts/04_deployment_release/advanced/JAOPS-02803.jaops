ja source 0.3
module corpus.ja_operations.example_02803
use Operations
policy explicit_network

workspace SuiteJAOPS_02803 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_89 replicas 4
    health_check worker_89 every 19s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02803.msslb"