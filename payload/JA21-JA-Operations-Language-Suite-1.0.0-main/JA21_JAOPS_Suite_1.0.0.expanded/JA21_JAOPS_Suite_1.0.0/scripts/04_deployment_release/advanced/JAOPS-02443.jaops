ja source 0.3
module corpus.ja_operations.example_02443
use Operations
policy explicit_network

workspace SuiteJAOPS_02443 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 15GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_20 replicas 4
    health_check worker_20 every 31s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_02443.msslb"