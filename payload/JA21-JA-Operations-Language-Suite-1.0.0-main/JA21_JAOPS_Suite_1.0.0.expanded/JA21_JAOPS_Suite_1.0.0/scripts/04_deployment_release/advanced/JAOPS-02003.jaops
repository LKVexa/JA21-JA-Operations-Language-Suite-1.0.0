module corpus.ja_operations.example_02003
use Operations
policy explicit_network

workspace SuiteJAOPS_02003 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 5 memory 7GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_65 replicas 4
    health_check worker_65 every 25s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_02003.msslb"