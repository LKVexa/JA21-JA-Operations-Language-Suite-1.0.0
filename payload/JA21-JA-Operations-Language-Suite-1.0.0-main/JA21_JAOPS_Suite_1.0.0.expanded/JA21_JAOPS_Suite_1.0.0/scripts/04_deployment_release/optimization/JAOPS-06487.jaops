module corpus.ja_operations.example_06487
use Operations
policy explicit_network

workspace SuiteJAOPS_06487 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_87 replicas 4
    health_check worker_87 every 14s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06487.msslb"