ja source 0.3
module corpus.ja_operations.example_06007
use Operations
policy explicit_network

workspace SuiteJAOPS_06007 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_92 replicas 4
    health_check worker_92 every 30s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_06007.msslb"