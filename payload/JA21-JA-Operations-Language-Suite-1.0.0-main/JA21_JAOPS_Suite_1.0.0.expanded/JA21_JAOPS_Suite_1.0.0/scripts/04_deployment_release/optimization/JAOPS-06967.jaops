module corpus.ja_operations.example_06967
use Operations
policy explicit_network

workspace SuiteJAOPS_06967 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 9 memory 11GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_82 replicas 4
    health_check worker_82 every 29s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_06967.msslb"