ja source 0.3
module corpus.ja_operations.example_08149
use Operations
policy explicit_network

workspace SuiteJAOPS_08149 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_3 replicas 2
    health_check worker_3 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08149.msslb"