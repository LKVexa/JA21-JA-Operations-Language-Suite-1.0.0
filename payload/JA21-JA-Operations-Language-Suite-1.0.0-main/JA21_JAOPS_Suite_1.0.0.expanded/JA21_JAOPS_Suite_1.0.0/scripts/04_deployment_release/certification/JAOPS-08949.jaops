module corpus.ja_operations.example_08949
use Operations
policy explicit_network

workspace SuiteJAOPS_08949 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_27 replicas 2
    health_check worker_27 every 27s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08949.msslb"