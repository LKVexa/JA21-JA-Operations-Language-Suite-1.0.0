module corpus.ja_operations.example_08789
use Operations
policy explicit_network

workspace SuiteJAOPS_08789 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 9GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_61 replicas 2
    health_check worker_61 every 22s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_08789.msslb"