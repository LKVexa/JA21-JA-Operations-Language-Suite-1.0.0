ja source 0.3
module corpus.ja_operations.example_08749
use Operations
policy explicit_network

workspace SuiteJAOPS_08749 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 7 memory 17GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_21 replicas 2
    health_check worker_21 every 13s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_08749.msslb"