ja source 0.3
module corpus.ja_operations.example_04705
use Operations
policy explicit_network

workspace SuiteJAOPS_04705 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 3 memory 5GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_51 replicas 2
    health_check worker_51 every 30s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_04705.msslb"