ja source 0.3
module corpus.ja_operations.example_01592
use Operations
policy explicit_network

workspace SuiteJAOPS_01592 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 2 memory 12GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_42 replicas 1
    health_check worker_42 every 17s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_01592.msslb"