ja source 0.3
module corpus.ja_operations.example_05436
use Operations
policy explicit_network

workspace SuiteJAOPS_05436 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 16GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_6 replicas 1
    health_check worker_6 every 17s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05436.msslb"