module corpus.ja_operations.example_05796
use Operations
policy explicit_network

workspace SuiteJAOPS_05796 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_75 replicas 1
    health_check worker_75 every 36s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05796.msslb"