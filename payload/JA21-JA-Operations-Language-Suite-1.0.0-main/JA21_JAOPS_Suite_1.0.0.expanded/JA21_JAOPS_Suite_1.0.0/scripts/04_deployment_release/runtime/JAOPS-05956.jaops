module corpus.ja_operations.example_05956
use Operations
policy explicit_network

workspace SuiteJAOPS_05956 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 6 memory 8GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_41 replicas 1
    health_check worker_41 every 10s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_05956.msslb"