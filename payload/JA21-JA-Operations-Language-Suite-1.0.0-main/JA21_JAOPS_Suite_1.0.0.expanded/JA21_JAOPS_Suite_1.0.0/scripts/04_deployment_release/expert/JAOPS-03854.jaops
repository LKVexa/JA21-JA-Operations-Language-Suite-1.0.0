module corpus.ja_operations.example_03854
use Operations
policy explicit_network

workspace SuiteJAOPS_03854 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_73 replicas 3
    health_check worker_73 every 16s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03854.msslb"