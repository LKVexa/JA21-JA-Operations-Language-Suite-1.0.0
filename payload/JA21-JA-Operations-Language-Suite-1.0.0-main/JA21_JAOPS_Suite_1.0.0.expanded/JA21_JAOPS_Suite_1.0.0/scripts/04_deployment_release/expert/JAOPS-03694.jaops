module corpus.ja_operations.example_03694
use Operations
policy explicit_network

workspace SuiteJAOPS_03694 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_10 replicas 3
    health_check worker_10 every 11s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03694.msslb"