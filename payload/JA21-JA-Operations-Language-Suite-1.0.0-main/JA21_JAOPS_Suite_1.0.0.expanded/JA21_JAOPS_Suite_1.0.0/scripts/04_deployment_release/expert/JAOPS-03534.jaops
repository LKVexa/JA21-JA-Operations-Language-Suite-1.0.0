module corpus.ja_operations.example_03534
use Operations
policy explicit_network

workspace SuiteJAOPS_03534 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 18GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_44 replicas 3
    health_check worker_44 every 6s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_03534.msslb"