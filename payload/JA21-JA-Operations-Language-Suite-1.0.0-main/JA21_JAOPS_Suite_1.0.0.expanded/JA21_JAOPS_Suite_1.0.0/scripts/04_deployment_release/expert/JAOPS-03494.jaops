module corpus.ja_operations.example_03494
use Operations
policy explicit_network

workspace SuiteJAOPS_03494 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_4 replicas 3
    health_check worker_4 every 28s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_03494.msslb"