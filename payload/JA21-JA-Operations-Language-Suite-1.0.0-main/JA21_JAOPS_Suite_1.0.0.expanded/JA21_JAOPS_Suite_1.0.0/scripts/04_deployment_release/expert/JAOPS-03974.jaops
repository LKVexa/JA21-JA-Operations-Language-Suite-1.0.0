module corpus.ja_operations.example_03974
use Operations
policy explicit_network

workspace SuiteJAOPS_03974 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network implicit
    secret signing_key reference "vault://release/signing"
    service worker_96 replicas 3
    health_check worker_96 every 12s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == false
emit package "SuiteJAOPS_03974.msslb"