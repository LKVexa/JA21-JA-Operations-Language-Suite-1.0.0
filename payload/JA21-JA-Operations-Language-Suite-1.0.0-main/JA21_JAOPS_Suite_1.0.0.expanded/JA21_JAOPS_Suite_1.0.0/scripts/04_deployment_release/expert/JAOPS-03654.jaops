module corpus.ja_operations.example_03654
use Operations
policy explicit_network

workspace SuiteJAOPS_03654 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_67 replicas 3
    health_check worker_67 every 33s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03654.msslb"