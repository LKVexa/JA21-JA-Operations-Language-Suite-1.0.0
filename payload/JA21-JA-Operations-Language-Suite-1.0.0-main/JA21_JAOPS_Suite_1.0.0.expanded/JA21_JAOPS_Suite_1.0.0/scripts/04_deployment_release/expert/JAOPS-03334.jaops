module corpus.ja_operations.example_03334
use Operations
policy explicit_network

workspace SuiteJAOPS_03334 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_38 replicas 3
    health_check worker_38 every 23s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03334.msslb"