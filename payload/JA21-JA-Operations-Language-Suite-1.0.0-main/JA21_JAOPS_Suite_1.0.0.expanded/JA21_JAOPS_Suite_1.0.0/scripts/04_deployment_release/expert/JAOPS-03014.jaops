ja source 0.3
module corpus.ja_operations.example_03014
use Operations
policy explicit_network

workspace SuiteJAOPS_03014 {
    target windows-x64
    compiler profile release
    dependencies locked
    environment offline
    resource cpu 8 memory 10GB
    network disabled
    secret signing_key reference "vault://release/signing"
    service worker_9 replicas 3
    health_check worker_9 every 13s
    upgrade rolling
    rollback on health_failure
    package msslb
}
assert deployment.reproducible == true
emit package "SuiteJAOPS_03014.msslb"